{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kibo",
  "version": "1.0.2",
  "identifier": "com.raahim.kibo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/?mode=desktop",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kibo",
        "url": "index.html",
        "width": 960,
        "height": 580,
        "x": 0,
        "y": 0,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,MediaRouter,OptimizationHints,Translate --disable-background-networking --disable-component-update --disable-default-apps"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
